VIA_ALLOWED_DIRS=C:\Users\Nama\Documents;C:\Users\Nama\PicturesVIA_ALLOWED_DIRS=C:\Users\Nama\Documents;C:\Users\Nama\Pictures# LLM Provider (gemini | anoman)
LLM_PROVIDER=anoman

# Anoman API Key
ANOMAN_API_KEY=your_anoman_api_key

# Gemini API Key
GEMINI_API_KEY=your_gemini_api_key

# ElevenLabs - TTS Account
ELEVENLABS_TTS_API_KEY=your_elevenlabs_TTS_api_key
ELEVENLABS_TTS_VOICE_ID=your_id_voice
ELEVENLABS_TTS_MODEL=eleven_multilingual_v2

# ElevenLabs - STT Account
ELEVENLABS_STT_API_KEY=your_elevenlabs_STT_api_key
ELEVENLABS_STT_MODEL=scribe_v1

# (Opsional) Override nama model (src/ai/llm-client.js)
GEMINI_MODEL_PRIMARY=gemini-2.0-flash-lite
GEMINI_MODEL_FOLLOWUP=gemini-2.0-flash
ANOMAN_MODEL_PRIMARY=claude-haiku-4-5
ANOMAN_MODEL_FOLLOWUP=claude-opus-4-7
# --- Agen (opsional) ---
# Batas langkah tool call per permintaan (default 6)
VIA_MAX_AGENT_STEPS=6
# Folder yang boleh dibaca/dicari/ditulis tool (pisahkan dengan ; atau ,). Default: folder home
VIA_ALLOWED_DIRS=C:\Users\Nama\Documents;C:\Users\Nama\Pictures
# Tool yang boleh jalan tanpa konfirmasi suara (tetap WAJIB konfirmasi setelah membaca isi PDF/gambar)
VIA_AUTO_TOOLS=open_browser

# --- Mode coding: baca/edit folder proyek (tool project_*) ---
# Model khusus pekerjaan coding. Dipakai begitu tool project_* dipanggil; kosong = pakai model FOLLOWUP.
# Sebaiknya mampu membaca gambar juga (bila gambar ikut ada di giliran yang sama).
GEMINI_MODEL_CODING=gemini-2.0-flash-lite
ANOMAN_MODEL_CODING=claude-opus-4-7
# Batas langkah tool call per permintaan saat mode coding (default 24)
VIA_MAX_CODING_STEPS=24
